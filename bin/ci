#!/usr/bin/env bash
set -euo pipefail
bash -n bootstrap.sh bin/bootstrap bin/ci bin/docker-entrypoint \
  script/backup-db script/restore-db script/verify-backup script/dr-verify \
  script/dr-rehearsal script/prove-no-plaintext script/project-doctor \
  script/ops-check script/ops-report script/backup-retention script/ops-maintenance \
  script/offsite-roundtrip script/offsite-dr-rehearsal script/kek-recovery-check script/production-acceptance \
  script/scheduled-ops script/install-ops-scheduler script/ops-scheduler-doctor script/build-migration-bundle
script/crypto-self-test
script/security-self-test
script/repository-policy
script/portability-check
bin/rails zeitwerk:check
RAILS_ENV=test bin/rails db:migrate
bin/rails test
bin/rails test:system
bundle exec rubocop
bundle exec brakeman --no-pager -q
bundle exec bundle-audit check --update

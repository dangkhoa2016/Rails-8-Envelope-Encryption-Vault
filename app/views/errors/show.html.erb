<section class="w-full rounded-3xl border border-white/10 bg-white/[0.04] p-8 shadow-2xl shadow-black/20 sm:p-10" role="alert" aria-labelledby="error-title">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-300">Ruby Envelope Vault</p>
  <h1 id="error-title" class="mt-3 text-3xl font-semibold tracking-tight text-white"><%= error_title %></h1>
  <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300"><%= error_message %></p>

  <div class="mt-7 flex flex-wrap gap-3">
    <%= link_to "Return to sign in", new_session_path, class: "inline-flex min-h-10 items-center justify-center rounded-xl bg-indigo-500 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-300" %>
  </div>

  <p class="mt-8 break-all text-xs text-slate-500">
    Support reference:
    <code class="font-mono text-slate-400"><%= request.request_id %></code>
  </p>
</section>

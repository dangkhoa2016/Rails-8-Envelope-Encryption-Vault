<div class="mx-auto max-w-3xl">
  <%= render "settings/navigation" %>
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-300">Security</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight">Security settings</h1>
  <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400">Changing your password rotates the authenticated session, revokes every other active session, and records the security event.</p>

  <section class="mt-7 rounded-3xl border border-white/10 bg-white/[0.025] p-5 sm:p-6">
    <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-4">
      <div><h2 class="font-semibold">Change password</h2><p class="mt-1 text-xs text-slate-500">Current password verification is required.</p></div>
      <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 text-xs text-emerald-200">Session rotation</span>
    </div>
    <%= form_with url: settings_security_path, method: :patch, class: "mt-5 space-y-5" do |f| %>
      <div><%= f.label :current_password, "Current password", class: "text-sm font-medium text-slate-300" %><%= f.password_field :current_password, required: true, autocomplete: "current-password", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3" %></div>
      <div><%= f.label :password, "New password", class: "text-sm font-medium text-slate-300" %><%= f.password_field :password, required: true, minlength: 14, autocomplete: "new-password", aria: { describedby: "password-help" }, class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3" %><p id="password-help" class="mt-1.5 text-xs text-slate-500">Use at least 14 characters. This value is never displayed back to you.</p></div>
      <div><%= f.label :password_confirmation, "Confirm new password", class: "text-sm font-medium text-slate-300" %><%= f.password_field :password_confirmation, required: true, minlength: 14, autocomplete: "new-password", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3" %></div>
      <%= f.submit "Change password", class: "rounded-xl bg-indigo-500 px-4 py-3 text-sm font-semibold hover:bg-indigo-400" %>
    <% end %>
  </section>
</div>

<div class="mx-auto max-w-4xl">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-300">Immutable history</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Version history</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Restoring a historical version creates a new encrypted version. Existing history is never overwritten.</p>
    </div>
    <%= link_to "Back to item", vault_item_path(@item), class: "rounded-xl border border-white/10 px-3 py-2 text-sm text-slate-300 hover:bg-white/5" %>
  </div>

  <div class="mt-7 space-y-3">
    <% @versions.each do |version| %>
      <% current = @item.current_version_id == version.id %>
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.025] p-5" data-version-number="<%= version.version_number %>">
        <div>
          <div class="flex items-center gap-2"><span class="text-lg font-semibold">v<%= version.version_number %></span><% if current %><span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 text-xs text-emerald-200" data-version-status="current">Current</span><% end %></div>
          <time class="mt-1 block text-sm text-slate-500" datetime="<%= version.created_at.iso8601 %>"><%= version.created_at.to_fs(:long) %></time>
        </div>
        <% unless current %>
          <%= button_to "Restore", restore_vault_item_version_path(@item, version), method: :post, form: { data: { turbo_confirm: "Restore v#{version.version_number} as a new encrypted version?" } }, class: "rounded-xl border border-amber-400/20 px-3 py-2 text-sm text-amber-300 hover:bg-amber-400/10" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

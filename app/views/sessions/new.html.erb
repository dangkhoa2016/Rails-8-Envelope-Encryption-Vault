<div class="mx-auto grid max-w-4xl overflow-hidden rounded-3xl border border-white/10 bg-white/[0.025] shadow-2xl shadow-black/20 lg:grid-cols-[1.05fr_.95fr]">
  <section class="p-7 sm:p-10">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-300">Secure access</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Sign in</h1>
    <p class="mt-2 text-sm leading-6 text-slate-400">Access your encrypted vault. Secrets remain encrypted at rest and are only revealed on explicit request.</p>
    <% if ENV.fetch("DEMO_MODE", "false") == "true" && ENV.fetch("SHOW_PUBLIC_DEMO_CREDENTIALS", "false") == "true" %>
      <div class="mt-5 rounded-xl border border-amber-300/20 bg-amber-300/10 px-4 py-3 text-sm text-amber-100" role="note">
        <p class="font-semibold">Public test account — synthetic data only</p>
        <p class="mt-2">Email: <code><%= ENV.fetch("DEMO_EMAIL") %></code></p>
        <p>Password: <code><%= ENV.fetch("DEMO_PASSWORD") %></code></p>
        <p class="mt-2 text-xs">This account is shared. Changes may be lost when the demo restarts. Never enter real credentials.</p>
      </div>
    <% end %>
    <%= form_with url: session_path, class: "mt-7 space-y-5" do |form| %>
      <div><%= form.label :email_address, "Email", class: "text-sm font-medium text-slate-300" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3 outline-none focus:border-indigo-400/50" %></div>
      <div><%= form.label :password, "Password", class: "text-sm font-medium text-slate-300" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3 outline-none focus:border-indigo-400/50" %></div>
      <%= form.submit "Sign in", class: "w-full rounded-xl bg-indigo-500 px-4 py-3 font-semibold hover:bg-indigo-400" %>
    <% end %>
    <% if ENV.fetch("ALLOW_SIGNUPS", "false") == "true" %>
      <p class="mt-5 text-center text-sm text-slate-500"><%= link_to "Create account", new_registration_path, class: "font-medium text-indigo-300 hover:text-indigo-200" %></p>
    <% end %>
  </section>
  <aside class="border-t border-white/10 bg-slate-950/50 p-7 sm:p-10 lg:border-l lg:border-t-0">
    <h2 class="text-lg font-semibold">Private by design</h2>
    <div class="mt-5 space-y-4 text-sm leading-6 text-slate-400">
      <p>Per-version envelope encryption with AES-256-GCM.</p>
      <p>Recent reauthentication gates sensitive actions.</p>
      <p>MFA, recovery codes, session revocation and audit history are built in.</p>
    </div>
  </aside>
</div>

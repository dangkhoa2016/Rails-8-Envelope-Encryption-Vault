<div class="mx-auto max-w-lg rounded-3xl border border-white/10 bg-white/[0.025] p-7 shadow-2xl shadow-black/20 sm:p-9">
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-300">Create your vault</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight">Create account</h1>
  <p class="mt-2 text-sm leading-6 text-slate-400">Use a unique password with at least 14 characters. You can enable MFA immediately after signing in.</p>
  <% if @user.errors.any? %>
    <div id="registration-errors" class="mt-5 rounded-2xl border border-rose-400/20 bg-rose-400/10 p-4 text-sm text-rose-100" role="alert" aria-live="assertive">
      <p class="font-medium">Please correct the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>
  <%= form_with model: @user, url: registration_path, class: "mt-7 space-y-5" do |form| %>
    <div><%= form.label :email_address, "Email", class: "text-sm font-medium text-slate-300" %><%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3" %></div>
    <div><%= form.label :password, "Password", class: "text-sm font-medium text-slate-300" %><%= form.password_field :password, required: true, minlength: 14, autocomplete: "new-password", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3" %></div>
    <div><%= form.label :password_confirmation, "Confirm password", class: "text-sm font-medium text-slate-300" %><%= form.password_field :password_confirmation, required: true, minlength: 14, autocomplete: "new-password", class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3" %></div>
    <%= form.submit "Create account", class: "w-full rounded-xl bg-indigo-500 px-4 py-3 font-semibold hover:bg-indigo-400" %>
  <% end %>
</div>

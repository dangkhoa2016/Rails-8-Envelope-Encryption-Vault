<section class="space-y-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <span class="inline-flex items-center rounded-full border border-indigo-400/20 bg-indigo-400/10 px-3 py-1 text-xs font-semibold text-indigo-200">AES-256-GCM envelope encryption</span>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Your encrypted vault</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Store credentials, API keys, secure notes, database access and server secrets in one protected workspace.</p>
    </div>
    <%= link_to "Create encrypted item", new_vault_item_path, class: "inline-flex items-center justify-center rounded-xl bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-400" %>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-white/10 bg-white/[0.035] p-5"><p class="text-sm text-slate-500">Active items</p><div class="mt-2 flex items-end justify-between"><strong class="text-3xl font-semibold"><%= @active_count %></strong><span class="text-xs text-slate-600"><%= @count %> total</span></div></div>
    <div class="rounded-2xl border border-white/10 bg-white/[0.035] p-5"><p class="text-sm text-slate-500">Protection</p><strong class="mt-2 block text-lg font-semibold text-emerald-200">Encrypted at rest</strong><p class="mt-1 text-xs text-slate-600">Envelope encryption + authenticated ciphertext</p></div>
    <div class="rounded-2xl border border-white/10 bg-white/[0.035] p-5"><p class="text-sm text-slate-500">Key provider</p><strong class="mt-2 block text-lg font-semibold"><%= Rails.configuration.x.vault.key_provider.to_s.humanize %></strong><p class="mt-1 text-xs text-slate-600"><%= @archived_count %> archived item(s)</p></div>
  </div>

  <div class="grid min-w-0 gap-6" data-dashboard-main-grid>
    <section class="min-w-0 rounded-2xl border border-white/10 bg-white/[0.025]">
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-4"><div><h2 class="font-semibold">Recently updated</h2><p class="mt-1 text-xs text-slate-500">Your latest active vault items</p></div><%= link_to "Open vault", vault_items_path, class: "text-sm font-medium text-indigo-300 hover:text-indigo-200" %></div>
      <% if @recent.any? %>
        <div class="divide-y divide-white/5">
          <% @recent.each do |item, title| %>
            <%= link_to vault_item_path(item), class: "flex items-center gap-4 px-5 py-4 transition hover:bg-white/[0.035]" do %>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[0.04] text-slate-300"><%= vault_kind_icon(item.kind) %></span>
              <span class="min-w-0 flex-1"><span class="block truncate text-sm font-medium text-slate-100"><%= title %></span><span class="mt-1 block text-xs text-slate-500"><%= vault_kind_label(item.kind) %> · updated <%= time_ago_in_words(item.updated_at) %> ago</span></span>
              <span class="text-slate-700">›</span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="px-5 py-10 text-center"><p class="text-sm text-slate-400">No secrets yet.</p><%= link_to "Create your first secret", new_vault_item_path, class: "mt-3 inline-block text-sm font-medium text-indigo-300" %></div>
      <% end %>
    </section>

    <div class="min-w-0 space-y-6">
      <section class="rounded-2xl border border-white/10 bg-white/[0.025] p-5">
        <div class="flex items-center justify-between gap-3"><div><h2 class="font-semibold">Favorites</h2><p class="mt-1 text-xs text-slate-500">Pinned items for faster access.</p></div></div>
        <% if @favorites.any? %>
          <div class="mt-4 space-y-2">
            <% @favorites.each do |item, title| %>
              <%= link_to vault_item_path(item), class: "flex items-center gap-3 rounded-xl border border-white/5 px-3 py-3 hover:border-white/10 hover:bg-white/[0.035]" do %>
                <span class="text-amber-300">★</span><span class="min-w-0 flex-1 truncate text-sm font-medium"><%= title %></span><span class="text-slate-700">›</span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-4 text-sm text-slate-500">Star important vault items to keep them close.</p>
        <% end %>
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/[0.025] p-5" aria-labelledby="security-posture-heading">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div><h2 id="security-posture-heading" class="font-semibold">Security posture</h2><p class="mt-1 text-xs text-slate-500">Account protections that affect sign-in and active browsers.</p></div>
          <%= link_to "Security settings", settings_security_path, class: "shrink-0 text-xs font-medium text-indigo-300 hover:text-indigo-200" %>
        </div>
        <dl class="mt-4 space-y-3">
          <div class="flex items-center justify-between gap-4 rounded-xl border border-white/5 px-3 py-3">
            <dt class="text-sm text-slate-400">Multi-factor authentication</dt>
            <dd class="shrink-0"><%= link_to(@mfa_enabled ? "Enabled" : "Not enabled", settings_mfa_path, class: "security-posture-nowrap rounded-full border px-2.5 py-1 text-xs font-medium #{@mfa_enabled ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-200" : "border-amber-400/20 bg-amber-400/10 text-amber-200"}") %></dd>
          </div>
          <div class="flex items-center justify-between gap-4 rounded-xl border border-white/5 px-3 py-3">
            <dt class="text-sm text-slate-400">Active sessions</dt>
            <dd class="shrink-0"><%= link_to pluralize(@active_session_count, "session"), settings_sessions_path, class: "security-posture-nowrap text-sm font-medium text-slate-200 hover:text-white" %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/[0.025] p-5">
        <h2 class="font-semibold">Quick create</h2><p class="mt-1 text-xs text-slate-500">Start from a purpose-built template.</p>
        <div class="mt-4 space-y-2">
          <% %w[login secure_note api_key database ssh].each do |kind| %>
            <%= link_to new_vault_item_path(kind: kind), class: "flex items-center gap-3 rounded-xl border border-white/5 px-3 py-3 hover:border-white/10 hover:bg-white/[0.035]" do %>
              <span class="text-slate-400"><%= vault_kind_icon(kind, css: "h-4 w-4") %></span>
              <span class="min-w-0"><span class="block text-sm font-medium"><%= vault_kind_label(kind) %></span><span class="block truncate text-xs text-slate-600"><%= vault_kind_description(kind) %></span></span>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</section>

<%= turbo_frame_tag "revealed_secret" do %>
  <div class="space-y-4 rounded-2xl border border-indigo-400/20 bg-slate-950/80 p-5" data-controller="reveal" data-reveal-timeout-value="30000">
    <p class="text-xs font-medium text-amber-300" data-secret-status>Plaintext will auto-hide after 30 seconds.</p>
    <div><span class="text-xs uppercase tracking-wide text-slate-500">Title</span><div class="mt-1 text-slate-200" data-secret-value><%= payload["title"] %></div></div>

    <% if payload["schema"] == "vault.environment.v1" %>
      <div class="space-y-2">
        <% payload.fetch("entries", []).each do |entry| %>
          <div class="grid gap-2 rounded-xl border border-white/10 p-3 md:grid-cols-[1fr_2fr_auto]" data-controller="clipboard">
            <code><%= entry["key"] %></code>
            <code class="break-all text-slate-300" data-clipboard-target="source" data-secret-value><%= entry["value"] %></code>
            <button type="button" data-action="clipboard#copy" class="rounded-lg border border-white/10 px-3 py-1 text-xs">Copy</button>
            <span class="text-xs text-emerald-300 md:col-start-3" aria-live="polite" data-clipboard-target="status"></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <% fields = [["body", "Secure note"], ["host", "Host"], ["port", "Port"], ["database_name", "Database"], ["username", "Username / ID"], ["password", "Secret / password"], ["url", "URL / endpoint"], ["notes", "Notes"]] %>
      <% fields.each do |key, label| %>
        <% value = payload[key].presence || ((key == "host") ? payload["url"].presence : nil) %>
        <% if value.present? %>
          <div data-controller="clipboard">
            <span class="text-xs uppercase tracking-wide text-slate-500"><%= label %></span>
            <div class="mt-1 flex items-start gap-3">
              <div class="min-w-0 flex-1 whitespace-pre-wrap break-all font-mono text-sm text-slate-200" data-clipboard-target="source" data-secret-value><%= value %></div>
              <button type="button" data-action="clipboard#copy" class="rounded-lg border border-white/10 px-3 py-1 text-xs">Copy</button>
            </div>
            <div class="text-xs text-emerald-300" aria-live="polite" data-clipboard-target="status"></div>
          </div>
        <% end %>
      <% end %>
      <% if Array(payload["tags"]).any? %>
        <div><span class="text-xs uppercase tracking-wide text-slate-500">Tags</span><div class="mt-2 flex flex-wrap gap-1.5"><% Array(payload["tags"]).each do |tag| %><span class="rounded-full border border-white/10 px-2 py-1 text-xs text-slate-400"><%= tag %></span><% end %></div></div>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="mx-auto max-w-5xl">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-start gap-4">
      <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl border border-white/10 bg-white/[0.04] text-slate-300"><%= vault_kind_icon(@item.kind, css: "h-6 w-6") %></span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="<%= vault_kind_badge_classes(@item.kind) %>"><%= vault_kind_label(@item.kind) %></span>
          <% if @item.archived_at.present? %><span class="rounded-full border border-amber-400/20 bg-amber-400/10 px-2.5 py-1 text-xs font-medium text-amber-200" data-vault-status="archived">Archived</span><% end %>
        </div>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight">Encrypted item</h1>
        <p class="mt-2 text-sm text-slate-500"><%= vault_kind_description(@item.kind) %></p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= render "favorite_control", item: @item %>
      <%= link_to "Edit", edit_vault_item_path(@item), class: "rounded-xl bg-indigo-500 px-4 py-2.5 text-sm font-semibold hover:bg-indigo-400" %>
      <%= link_to "Versions", vault_item_versions_path(@item), class: "rounded-xl border border-white/10 px-4 py-2.5 text-sm font-medium hover:bg-white/5" %>
      <% if @item.kind == "environment" %><%= button_to "Download .env", vault_item_export_path(@item), method: :post, class: "rounded-xl border border-white/10 px-4 py-2.5 text-sm font-medium" %><% end %>
    </div>
  </div>

  <dl class="mt-7 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-4">
    <% [["Type", vault_kind_label(@item.kind)], ["Current version", "v#{@item.current_version.version_number}"], ["Created", @item.created_at.to_fs(:short)], ["Updated", @item.updated_at.to_fs(:short)]].each do |label, value| %>
      <div class="bg-slate-950 px-4 py-4"><dt class="text-xs text-slate-600"><%= label %></dt><dd class="mt-1.5 text-sm font-medium text-slate-200"><%= value %></dd></div>
    <% end %>
  </dl>

  <section class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(260px,360px)]" aria-labelledby="template-guidance-heading">
    <div class="rounded-2xl border border-white/10 bg-white/[0.025] p-5">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-600">About this template</p>
      <h2 id="template-guidance-heading" class="mt-2 text-base font-semibold text-slate-200"><%= vault_kind_label(@item.kind) %></h2>
      <p class="mt-2 text-sm leading-6 text-slate-400"><%= vault_kind_best_for(@item.kind) %></p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-5">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-600">Protected field pattern</p>
      <p class="mt-2 text-sm leading-6 text-slate-400"><%= vault_kind_fields(@item.kind).join(" · ") %></p>
      <p class="mt-2 text-xs leading-5 text-slate-600">Field names describe the template only. Values stay encrypted until you reveal the item.</p>
    </div>
  </section>

  <section class="mt-6 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.025]">
    <div class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-4">
      <div><h2 class="font-semibold">Protected contents</h2><p class="mt-1 text-xs text-slate-500">Plaintext stays hidden until you explicitly reveal it.</p></div>
      <span class="inline-flex items-center gap-2 text-xs font-medium text-emerald-300"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Encrypted</span>
    </div>
    <div class="p-5">
      <%= turbo_frame_tag "revealed_secret" do %>
        <div class="rounded-2xl border border-dashed border-white/10 bg-slate-950/50 px-5 py-8 text-center">
          <p class="text-sm text-slate-400">Reveal requires recent identity confirmation when re-authentication is enabled.</p>
          <%= button_to "Reveal", vault_item_reveal_path(@item), method: :post, form: { data: { turbo_frame: "revealed_secret" } }, class: "mt-4 rounded-xl bg-indigo-500 px-4 py-2.5 text-sm font-semibold hover:bg-indigo-400" %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="mt-6 border-t border-white/10 pt-5">
    <%= link_to "← Back to vault", vault_items_path, class: "text-sm text-slate-500 hover:text-slate-300" %>
  </div>

  <section class="mt-8 rounded-2xl border border-white/10 bg-white/[0.02] p-5" aria-labelledby="item-lifecycle-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="item-lifecycle-heading" class="text-sm font-semibold text-slate-200">Item lifecycle</h2>
        <p class="mt-1 text-xs leading-5 text-slate-500"><%= @item.archived_at.present? ? "Restore this item to active vault results." : "Archiving hides the item from active results without deleting encrypted history." %></p>
      </div>
      <% if @item.archived_at.present? %>
        <%= button_to "Unarchive", unarchive_vault_item_path(@item), method: :post, class: "rounded-xl border border-emerald-400/20 px-4 py-2.5 text-sm font-medium text-emerald-300 hover:bg-emerald-400/5" %>
      <% else %>
        <%= button_to "Archive", archive_vault_item_path(@item), method: :post, form: { data: { turbo_confirm: "Archive this vault item?" } }, class: "rounded-xl border border-amber-400/20 px-4 py-2.5 text-sm font-medium text-amber-300 hover:bg-amber-400/5" %>
      <% end %>
    </div>
  </section>
</div>

<div data-controller="secret-field clipboard">
  <div class="flex items-center justify-between gap-3">
    <%= f.label :secret_value, "Secret / password", class: "text-sm font-medium text-slate-300" %>
    <div class="flex flex-wrap justify-end gap-3 text-xs">
      <button type="button"
              data-action="secret-field#toggle"
              data-secret-field-target="toggle"
              class="text-indigo-300 hover:text-indigo-200">
        Reveal
      </button>
      <button type="button"
              data-action="clipboard#copy"
              class="text-indigo-300 hover:text-indigo-200">
        Copy
      </button>
      <button type="button"
              data-action="secret-field#toggleGenerator"
              data-generator-toggle
              aria-expanded="false"
              aria-controls="secret-generator-options"
              class="text-indigo-300 hover:text-indigo-200">
        Generator options
      </button>
    </div>
  </div>

  <%= f.password_field :secret_value,
                       autocomplete: "new-password",
                       data: {
                         secret_input: true,
                         secret_field_target: "input",
                         clipboard_target: "source"
                       },
                       placeholder: (editing ? "Leave blank to keep the current secret" : nil),
                       class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3 outline-none focus:border-indigo-400/50" %>

  <p class="mt-1.5 min-h-4 text-xs text-emerald-300" aria-live="polite" data-clipboard-target="status"></p>

  <div id="secret-generator-options"
       data-secret-field-target="generator"
       class="mt-3 hidden rounded-2xl border border-white/10 bg-slate-950/50 p-4">
    <div>
      <p class="text-xs font-medium text-slate-400">Quick presets</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <button type="button"
                data-action="secret-field#applyPreset"
                data-preset="balanced"
                class="rounded-lg border border-white/10 px-3 py-1.5 text-xs text-slate-300 hover:bg-white/5">
          Balanced · 24
        </button>
        <button type="button"
                data-action="secret-field#applyPreset"
                data-preset="strong"
                class="rounded-lg border border-white/10 px-3 py-1.5 text-xs text-slate-300 hover:bg-white/5">
          Strong · 32
        </button>
        <button type="button"
                data-action="secret-field#applyPreset"
                data-preset="compatible"
                class="rounded-lg border border-white/10 px-3 py-1.5 text-xs text-slate-300 hover:bg-white/5">
          Compatible · 20
        </button>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-[180px] flex-1">
        <div class="flex items-center justify-between gap-3">
          <label for="secret-generator-length" class="text-xs font-medium text-slate-400">Length</label>
          <output data-secret-field-target="lengthOutput" for="secret-generator-length" class="text-xs font-semibold text-indigo-300">24</output>
        </div>
        <input id="secret-generator-length"
               type="range"
               min="16"
               max="64"
               value="24"
               data-secret-field-target="length"
               data-action="input->secret-field#updateLength"
               class="mt-2 w-full"
               aria-label="Generated secret length">
      </div>

      <button type="button"
              data-action="secret-field#generate"
              class="rounded-xl bg-indigo-500 px-4 py-2.5 text-xs font-semibold text-white hover:bg-indigo-400">
        Generate secure secret
      </button>
    </div>

    <fieldset class="mt-4">
      <legend class="text-xs font-medium text-slate-400">Character types</legend>
      <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
        <label class="inline-flex items-center gap-2 text-xs text-slate-400">
          <input type="checkbox" checked data-secret-field-target="uppercase" data-action="change->secret-field#updateStrength" class="rounded border-white/20 bg-slate-900 text-indigo-500">
          Uppercase
        </label>
        <label class="inline-flex items-center gap-2 text-xs text-slate-400">
          <input type="checkbox" checked data-secret-field-target="lowercase" data-action="change->secret-field#updateStrength" class="rounded border-white/20 bg-slate-900 text-indigo-500">
          Lowercase
        </label>
        <label class="inline-flex items-center gap-2 text-xs text-slate-400">
          <input type="checkbox" checked data-secret-field-target="numbers" data-action="change->secret-field#updateStrength" class="rounded border-white/20 bg-slate-900 text-indigo-500">
          Numbers
        </label>
        <label class="inline-flex items-center gap-2 text-xs text-slate-400">
          <input type="checkbox" checked data-secret-field-target="symbols" data-action="change->secret-field#updateStrength" class="rounded border-white/20 bg-slate-900 text-indigo-500">
          Symbols
        </label>
        <label class="inline-flex items-center gap-2 text-xs text-slate-400">
          <input type="checkbox" checked data-secret-field-target="ambiguous" data-action="change->secret-field#updateStrength" class="rounded border-white/20 bg-slate-900 text-indigo-500">
          Avoid ambiguous
        </label>
      </div>
    </fieldset>

    <p class="mt-3 text-xs leading-5 text-slate-500" data-secret-field-target="strength">Estimated search space will appear here.</p>
    <p class="mt-2 text-xs leading-5 text-slate-600">Generated locally in your browser using Web Crypto. Nothing is sent to the server until you save the item.</p>
    <p class="mt-2 min-h-4 text-xs text-emerald-300" aria-live="polite" data-secret-field-target="status"></p>
  </div>
</div>

<div class="mx-auto max-w-lg rounded-3xl border border-white/10 bg-white/[0.025] p-7 sm:p-9">
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-300">Second factor</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight">Two-factor authentication</h1>
  <p class="mt-2 text-sm leading-6 text-slate-400">Enter the current code from your authenticator. One unused recovery code can also be used if your authenticator is unavailable.</p>
  <%= form_with url: mfa_challenge_path, class: "mt-7 space-y-5" do |f| %>
    <div><%= f.label :token, "Authentication code", class: "text-sm font-medium text-slate-300" %><%= f.text_field :token, required: true, autocomplete: "one-time-code", inputmode: "numeric", autofocus: true, class: "mt-1.5 w-full rounded-xl border border-white/10 bg-slate-950/80 px-4 py-3 font-mono tracking-widest" %></div>
    <%= f.submit "Verify", class: "w-full rounded-xl bg-indigo-500 px-4 py-3 font-semibold" %>
  <% end %>
</div>

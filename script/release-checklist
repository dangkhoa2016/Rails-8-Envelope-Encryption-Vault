    f"  - HTTP security evidence SHA-256: `{d.get('http_security_preflight_sha256','unknown')}`",
    f"- [{mark(d.get('production_error_preflight')=='pass')}] Production failure-handling preflight passed",
    f"  - statuses: `404={d.get('production_error_status_404','unknown')}`, `422={d.get('production_error_status_422','unknown')}`, `500={d.get('production_error_status_500','unknown')}`",

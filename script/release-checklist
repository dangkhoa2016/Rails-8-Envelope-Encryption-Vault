    f"  - 429 session cookie: `{d.get('rate_limit_session_cookie_on_throttle','unknown')}`",
    f"  - health safelist: `{d.get('rate_limit_health_safelist','unknown')}`",
    f"  - cache store: `{d.get('rate_limit_cache_store_class','unknown')}`",
    f"  - secret values absent: `{d.get('rate_limit_secret_values_absent','unknown')}`",
    f"  - rate-limit evidence SHA-256: `{d.get('rate_limit_preflight_sha256','unknown')}`",
    f"- [{mark(d.get('session_lifecycle_preflight')=='pass')}] Production session lifecycle preflight passed",
    f"  - login session creation: `{d.get('session_login_creation','unknown')}`",
    f"  - cookie HttpOnly / SameSite strict / expiry: `{d.get('session_cookie_httponly','unknown')}` / `{d.get('session_cookie_same_site_strict','unknown')}` / `{d.get('session_cookie_has_expiry','unknown')}`",
    f"  - reauthentication rotation: `{d.get('session_reauthentication_rotation','unknown')}`",
    f"  - stale cookie rejection: `{d.get('session_stale_cookie_rejection','unknown')}`",
    f"  - other/current revocation: `{d.get('session_other_revocation','unknown')}` / `{d.get('session_current_revocation','unknown')}`",
    f"  - idle/absolute timeout rejection: `{d.get('session_idle_timeout_rejection','unknown')}` / `{d.get('session_absolute_timeout_rejection','unknown')}`",
    f"  - secret values absent: `{d.get('session_secret_values_absent','unknown')}`",

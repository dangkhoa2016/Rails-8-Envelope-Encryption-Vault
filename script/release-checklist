    f"- [{mark(d.get('private_dr_provenance')=='pass' and d.get('private_dr_snapshot_role')=='production-authority' and d.get('private_dr_production_authority_confirmed') is True and d.get('private_dr_source_equals_runtime_database') is False)}] Private DR production provenance passed",
    f"  - source type: `{d.get('private_dr_source_type','unknown')}`",
    f"  - source release: `{d.get('private_dr_source_release_version','unknown')}`",
    f"  - target release: `{d.get('private_dr_target_release_version','unknown')}`",
    f"  - provenance SHA-256: `{d.get('private_dr_provenance_sha256','unknown')}`",
    f"- [{mark(d.get('production_database_prepare')=='pass' and d.get('production_database_live_contract') in ('pass','pending') and d.get('production_database_stable_name_contract') is True)}] Stable production database contract prepared",
    f"  - expected database: `{d.get('production_database_expected_name','unknown')}`",
    f"  - active database: `{d.get('production_database_name','pending')}`",
    f"  - prepare status: `{d.get('production_database_prepare','unknown')}`",
    f"  - live contract: `{d.get('production_database_live_contract','unknown')}`",
    f"  - prepare SHA-256: `{d.get('production_database_prepare_sha256','pending')}`",
    f"  - live contract SHA-256: `{d.get('production_database_contract_sha256','pending')}`",
    f"- [{mark(d.get('aws_kms_fresh_host_rehearsal')=='pass' and d.get('aws_kms_live_ready') is True and d.get('aws_kms_live_smoke')=='pass')}] AWS KMS fresh-host live rehearsal passed",
    f"  - live ready: `{d.get('aws_kms_live_ready','unknown')}`",
    f"  - live smoke: `{d.get('aws_kms_live_smoke','unknown')}`",
    f"  - historical decrypt: `{d.get('aws_kms_historical_decrypt','unknown')}`",
    f"  - rewrap: `{d.get('aws_kms_rewrap','unknown')}`",

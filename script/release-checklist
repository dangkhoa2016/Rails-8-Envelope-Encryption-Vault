    f"- [{mark(d.get('upgrade_from_fix46_preflight')=='pass')}] FIX46-to-milestone upgrade preflight passed",
    f"  - upgrade base: `{d.get('upgrade_base_version','unknown')}`",
    f"  - migration set identical: `{d.get('upgrade_migration_set_identical','unknown')}`",
    f"  - db:migrate idempotent: `{d.get('upgrade_db_migrate_idempotent','unknown')}`",
    f"  - pending migrations: `{d.get('upgrade_pending_migrations','unknown')}`",
    f"  - persistent database reused: `{d.get('upgrade_persistent_database_reused','unknown')}`",
    f"  - project doctor: `{d.get('upgrade_project_doctor','unknown')}`",
    f"  - secret values absent: `{d.get('upgrade_secret_values_absent','unknown')}`",
    f"  - upgrade evidence SHA-256: `{d.get('upgrade_preflight_sha256','unknown')}`",
    f"  - links checked: `{d.get('public_package_links_checked','unknown')}`",
    f"  - screenshots: `{d.get('public_package_screenshots','unknown')}`",
    f"  - root files: `{d.get('public_package_root_files','unknown')}`",
    f"  - manifest rows: `{d.get('public_package_manifest_rows','unknown')}`",
    "",
    "## Artifact SHA-256",
    "",
]
for name,sha in sorted(d.get("artifact_sha256",{}).items()):
    lines.append(f"- [x] `{name}` — `{sha}`")
lines += [
    "",
    f"Metadata generated at: `{d.get('generated_at','unknown')}`",
    "",
    "> Automated UX/accessibility PASS does not imply manual accessibility completion or WCAG conformance.",
    "",
]
out.write_text("\n".join(lines))
PY
chmod 644 "$OUT"
echo "RELEASE_CHECKLIST=PASS path=$OUT"

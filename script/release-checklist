#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
ARTIFACT_DIR="${RELEASE_ARTIFACT_DIR:-$ROOT/tmp/release-artifacts}"
META="${RELEASE_METADATA_FILE:-$ARTIFACT_DIR/RELEASE-METADATA.json}"
OUT="${RELEASE_CHECKLIST_OUT:-$ARTIFACT_DIR/OPERATOR-RELEASE-CHECKLIST.md}"

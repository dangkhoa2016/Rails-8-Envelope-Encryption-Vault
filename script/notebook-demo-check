#!/usr/bin/env python3
"""Check release-first Kaggle/Colab notebook content and source contract."""
import ast
import contextlib
import io
import json
import re
import subprocess
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
NOTEBOOK = ROOT / 'notebooks/Rails_8_Envelope_Encryption_Vault_Kaggle_Colab_Demo.ipynb'
errors = []

books = sorted((ROOT / 'notebooks').glob('*.ipynb'))
if books != [NOTEBOOK]:
    errors.append('Expected exactly one canonical notebook')
try:
    notebook = json.loads(NOTEBOOK.read_text())
except (OSError, ValueError) as exc:
    raise SystemExit('NOTEBOOK_DEMO_CHECK=FAIL invalid notebook: '+str(exc))

cells = notebook.get('cells', [])
if notebook.get('nbformat') != 4 or len(cells) != 23:
    errors.append('Notebook must contain the canonical 23 Jupyter v4 cells')
sources = []
code_count = 0
for i, cell in enumerate(cells):
    src = cell.get('source', '')
    src = ''.join(src) if isinstance(src, list) else src
    sources.append(src)
    if cell.get('cell_type') == 'code':
        code_count += 1
        if cell.get('outputs') or cell.get('execution_count') is not None:
            errors.append(f'cell {i}: executable outputs/history may not be published')
        try:
            ast.parse(src, filename=f'notebook-cell-{i}')
        except SyntaxError as exc:
            errors.append(f'cell {i}: Python syntax error: {exc}')

body = '\n'.join(sources)
settings = sources[2] if len(sources)>2 else ''
clone = sources[4] if len(sources)>4 else ''
required = {
    'official repo': 'REPO_SLUG = "dangkhoa2016/Rails-8-Envelope-Encryption-Vault"',
    'main fetch': 'REF = "main"',
    'explicit release tag': 'RELEASE_REF = "v1.0.0"',
    'source kind': 'SOURCE_KIND = "ANNOTATED_RELEASE_TAG"',
    'anonymous public checkout': 'GIT_TERMINAL_PROMPT',
    'anonymous public clone': '"--branch", REF, "--single-branch",',
    'release version': 'RELEASE_VERSION_MISMATCH',
    'release tag type': 'RELEASE_TAG_INVALID',
    'release ancestry': 'RELEASE_TAG_NOT_ON_MAIN',
    'Git integrity': '"fsck", "--full", "--strict"',
    'detached tag checkout': '"checkout", "--detach", release_commit',
    'release source trace': 'SOURCE_TREE_VERIFIED=PASS',
    'full release application trace': 'RELEASE_CHECKOUT=PASS',
    'release main parity status': 'RELEASE_SOURCE_PARITY=PASS',
    'file checkout cleanliness': 'RELEASE_SOURCE_DIRTY',
    'synthetic DB': 'DB_NAME = f"vault_demo_db_{RUN_ID}"',
    'test suite': 'bin/rails test',
    'system suite': 'bin/rails test:system',
    'test-only umask': 'umask 022',
    'synthetic fixtures': 'demo:fixture',
    'Rails readiness': 'RAILS_DB_READINESS=PASS',
    'local health gate': 'RAILS_HEALTH=PASS',
    'tunnel checksum': 'CLOUDFLARED_SHA256',
    'interactive shutdown': 'stop_button.on_click(',
}
for meaning, snippet in required.items():
    if snippet not in body:
        errors.append('Missing contract: '+meaning)
for legacy in ('EXPECTED_SOURCE_COMMIT', 'EXPECTED_SOURCE_TREE',
               'PINNED_MAIN_COMMIT', 'RELEASE_DOCUMENT_PATHS',
               'RELEASE_EXECUTABLE_DRIFT', '7f58d38c8578', 'bcea98b41ff3'):
    if legacy in body:
        errors.append('Obsolete historical source contract: '+legacy)
if '--depth", "1"' in clone:
    errors.append('Shallow main clone would omit earlier tagged source')
if re.search(r'(ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|BEGIN (?:RSA|OPENSSH) PRIVATE KEY)', body):
    errors.append('Potential embedded credential')
if any(x in body for x in ('--allowed-mail', 'ACCESS_EMAIL', 'Email you control for Cloudflare OTP')):
    errors.append('Unsupported Cloudflare OTP description')
if not all(x in settings for x in ('DEMO_EXPERIENCE = "explore"',
                                 'ARTIFACTS = EVIDENCE_ROOT / RUN_ID',
                                 'CAPTURE_SCREENSHOTS = DEMO_EXPERIENCE == "verify"')):
    errors.append('Explore/Verify settings must remain user-first')
if len(sources)>14:
    if 'bin/rails test' in sources[6]:
        errors.append('Explore bootstrap must not run full Rails tests')
    if 'if DEMO_EXPERIENCE == "verify":' not in sources[14]:
        errors.append('Verify must explicitly run full test suites')
if len(sources)>12 and not all(x in sources[12] for x in
   ('CLOUDFLARED_VERSION = "2026.10.3"',
    'CLOUDFLARED_SHA256 = "053b80b0a23031a038fdbf3c073f59f82b8f1f152aa67971d7383ffafc0dbab0"',
    'if checksum(temp_binary) != CLOUDFLARED_SHA256:')):
    errors.append('Cloudflared binary version/hash must be verified')
if 'releases/latest/download/cloudflared' in body:
    errors.append('Floating cloudflared binary disallowed')
if len(sources)>8 and 'password_file = ARTIFACTS / "demo-password.txt"' not in sources[8]:
    errors.append('Disposable password file missing')
if len(sources)>22 and not all(x in sources[22] for x in ('STOP_DEMO_NOW = False', 'stop_button.on_click(')):
    errors.append('Interactive stop and manual fallback missing')
for path in [ROOT/'docs/KAGGLE-SETUP.md', ROOT/'docs/KAGGLE-SETUP.vi.md']:
    text=path.read_text()
    if not all(x in text for x in ('DEMO_EXPERIENCE', 'Explore', 'Verify', 'STOP_DEMO_NOW','v1.0.0')):
        errors.append(path.name+': outdated release/Explore/Verify guidance')

# Exercise the *actual final summary code* with a synthetic Explore session.
# Syntax checks cannot detect undefined variables such as a stale `sha` name.
# This regression fixture must stay independent of Rails, network and real secrets.
def run_final_summary_fixture():
    final = sources[20] if len(sources)>20 else ''
    if not final:
        raise AssertionError('Missing final summary cell 20')
    commit = 'a' * 40
    tree = 'b' * 40
    fake = {
        'CAPTURE_SCREENSHOTS': False,
        'RELEASE_COMMIT': commit,
        'RELEASE_TREE': tree,
        'local_url': 'http://127.0.0.1:1234',
        'tunnel_url': None,
        'DEMO_EMAIL': 'test@example.invalid',
        'demo_password': 'synthetic-test-only',
        'ARTIFACTS': Path('/tmp/synthetic-evidence'),
    }
    with contextlib.redirect_stdout(io.StringIO()) as capture:
        exec(compile(final, '<notebook-final-summary>', 'exec'), fake)
    value = capture.getvalue()
    for marker in ('SOURCE_SHA: ' + commit,
                   'SOURCE_TREE: ' + tree,
                   'LOCAL_URL: http://127.0.0.1:1234',
                   'Explore complete.'):
        if marker not in value:
            raise AssertionError('Final summary omitted: ' + marker)
    if 'BROWSER_DEMO_URL:' in value:
        raise AssertionError('Disabled Cloudflare mode leaked a browser URL')
    return True

# Execute THE notebook's source verification function against local Git fixtures.
# This catches unsafe changes without requiring GitHub access or Rails boot.
def run_source_contract_fixtures():
    source=ast.parse(clone)
    functions=[n for n in source.body if isinstance(n, ast.FunctionDef) and n.name=='verify_release_source']
    if len(functions)!=1:
        raise AssertionError('Exactly one source verifier function required')
    code=compile(ast.Module(body=functions,type_ignores=[]),'<notebook-release-contract>','exec')
    def shell(cwd,*arguments,check=True):
        result=subprocess.run(['git',*arguments],cwd=cwd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
        if check and result.returncode:
            raise AssertionError('git fixture failed: '+str(arguments)+' '+result.stderr[:200])
        return result.stdout.strip()
    def notebook_git(*arguments,cwd=None,env=None):
        return subprocess.run(['git',*arguments],cwd=cwd,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=True).stdout.strip()
    env={'git':notebook_git,'subprocess':subprocess,'RELEASE_REF':'v1.0.0',
         'SOURCE_KIND':'ANNOTATED_RELEASE_TAG'}
    exec(code,env)
    verifier=env['verify_release_source']
    with tempfile.TemporaryDirectory(prefix='ruby-envelope-notebook-contract-') as folder:
        project=Path(folder)
        shell(project,'init','-q')
        shell(project,'config','user.name','Test Publisher')
        shell(project,'config','user.email','test@example.invalid')
        (project/'README.md').write_text('# Rails 8 Envelope Encryption Vault\n')
        (project/'README.vi.md').write_text('# Rails 8 Envelope Encryption Vault\n')
        (project/'VERSION').write_text('1.0.0\n')
        shell(project,'add','README.md','README.vi.md','VERSION')
        shell(project,'commit','-qm','source fixture')
        first=shell(project,'rev-parse','HEAD')
        shell(project,'tag','-a','v1.0.0','-m','reviewed release')
        shell(project,'update-ref','refs/remotes/origin/main',first)
        with contextlib.redirect_stdout(io.StringIO()) as stream:
            commit, tree=verifier(project)
        assert commit==first and len(tree)==40
        assert 'RELEASE_SOURCE_PARITY=PASS' in stream.getvalue()
        # A later main commit does not invalidate a previously published tag.
        shell(project,'checkout','-qb','later')
        (project/'LATER.md').write_text('Later unreleased work\n')
        shell(project,'add','LATER.md')
        shell(project,'commit','-qm','later main')
        second=shell(project,'rev-parse','HEAD')
        shell(project,'update-ref','refs/remotes/origin/main',second)
        with contextlib.redirect_stdout(io.StringIO()) as stream:
            old, _=verifier(project)
        assert old==first and 'MAIN_HAS_NEWER_COMMITS=INFO' in stream.getvalue()
        # Guard: release may not point to an unrelated / unpublished future commit.
        shell(project,'tag','-f','-a','v1.0.0','-m','mismatched tag',second)
        shell(project,'update-ref','refs/remotes/origin/main',first)
        try:verifier(project)
        except RuntimeError as exc:assert 'RELEASE_TAG_NOT_ON_MAIN' in str(exc)
        else:raise AssertionError('Release tag outside main was accepted')
        # Guard: lightweight Git tags are not accepted.
        shell(project,'tag','-d','v1.0.0')
        shell(project,'tag','v1.0.0',first)
        try:verifier(project)
        except RuntimeError as exc:assert 'RELEASE_TAG_INVALID' in str(exc)
        else:raise AssertionError('Lightweight tag was accepted')
        # Guard: incorrect VERSION aborts, even for a valid annotated tag.
        shell(project,'checkout','later')
        (project/'VERSION').write_text('9.9.9\n')
        shell(project,'add','VERSION')
        shell(project,'commit','-qm','wrong version')
        bad=shell(project,'rev-parse','HEAD')
        shell(project,'tag','-f','-a','v1.0.0','-m','bad version',bad)
        shell(project,'update-ref','refs/remotes/origin/main',bad)
        try:verifier(project)
        except RuntimeError as exc:assert 'RELEASE_VERSION_MISMATCH' in str(exc)
        else:raise AssertionError('Wrong release version was accepted')

try:
    if not errors:
        run_source_contract_fixtures()
        run_final_summary_fixture()
except Exception as exc:
    errors.append('Executable notebook fixture: '+str(exc))

if errors:
    for issue in errors:print('ERROR:',issue)
    raise SystemExit('NOTEBOOK_DEMO_CHECK=FAIL')
print(f'NOTEBOOK_DEMO_CHECK=PASS cells={len(cells)} code_cells={code_count} '
      'source=annotated-v1.0.0 git_fixtures=5 summary_fixture=PASS outputs=clean')

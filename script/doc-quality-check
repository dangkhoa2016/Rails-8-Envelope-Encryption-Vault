#!/usr/bin/env python3
"""Source-only bilingual documentation, badge and local-link integrity gate."""
from pathlib import Path
from urllib.parse import unquote
import re
import sys
import subprocess

ROOT=Path(__file__).resolve().parents[1]
docs=sorted(ROOT/p for p in subprocess.check_output(['git','-C',str(ROOT),'ls-files','--cached','--others','--exclude-standard','--','*.md'],text=True).splitlines())
errors=[]
# Repository convention: keep the GitHub landing pages at the root;
# store every other narrative Markdown pair in docs/ or .github/.
root_pages=[p.relative_to(ROOT).as_posix() for p in docs if p.parent==ROOT and p.name not in ("README.md", "README.vi.md")]
if root_pages:
    errors.append("Root Markdown documents must live under docs/: " + ", ".join(root_pages))
# GitHub resolves README.md by .github/ -> root -> docs/.
# A community index in .github/README.md hides the actual project landing page.
for forbidden in (".github/README.md", ".github/README.vi.md"):
    if (ROOT/forbidden).exists():
        errors.append("GitHub README precedence violation: " + forbidden + " hides the root project README")
for required in ("docs/README.md", "docs/README.vi.md", "docs/SECURITY.md", "docs/SECURITY.vi.md", "README.md", "README.vi.md", "docs/COMMUNITY.md", "docs/COMMUNITY.vi.md"):
    if not (ROOT/required).is_file():
        errors.append("Missing canonical documentation: " + required)
checked=0
pair_count=0
for p in docs:
    rel=p.relative_to(ROOT)
    if p.name.endswith('.vi.md'):
        partner=p.with_name(p.name[:-6]+'.md')
        switch='[English]('+partner.name+')'
    else:
        partner=p.with_name(p.stem+'.vi.md')
        switch='[Tiếng Việt]('+partner.name+')'
        pair_count+=1
    if not partner.is_file():errors.append(str(rel)+': missing bilingual partner')
    content=p.read_text()
    if switch not in content:errors.append(str(rel)+': missing language switch')
    if '🌐 Language / Ngôn ngữ:' not in content:errors.append(str(rel)+': missing language header')
    if re.search(r'(?i)(?<![\w])(?:v?0[.]1[.]\d+|RC[-_ ]?\d+|release candidate|FIX\d+)(?![\w])',content):
        errors.append(str(rel)+': legacy version or milestone text')
    for target in re.findall(r'\[[^\]]*\]\(([^)]+)\)',content):
        target=unquote(target.split('#',1)[0].strip())
        if not target or target.startswith(('http:', 'https:', 'mailto:', 'data:')):continue
        if ' ' in target:target=target.split(' ',1)[0]
        checked+=1
        dest=(p.parent/target).resolve()
        if not dest.is_relative_to(ROOT.resolve()):errors.append(str(rel)+': link outside repo '+target)
        elif not dest.exists():errors.append(str(rel)+': broken link '+target)
if (ROOT/'VERSION').read_text().strip()!='1.0.0':errors.append('VERSION mismatch')
license=(ROOT/'LICENSE').read_text()
if 'MIT License' not in license or 'Đăng Khoa <i.am@dangkhoa.dev>' not in license:
    errors.append('MIT license attribution mismatch')
readme=(ROOT/'README.md').read_text()
for badge in ('actions/workflows/ci.yml/badge.svg','actions/workflows/docs.yml/badge.svg','license-MIT','source%20tag-v1.0.0','Rails-8','PostgreSQL-17'):
    if badge not in readme:errors.append('README badge missing: '+badge)
# Catch release-facing errors missed by existence-only link checks.
for landing in ("README.md", "README.vi.md"):
    content=(ROOT/landing).read_text()
    if r"\\n\\n" in content: errors.append(landing+": literal escaped newlines")
    start=content.find("| Seven item templates |" if landing=="README.md" else "| Bảy mẫu bí mật |")
    end=content.find("| Recovery operations |" if landing=="README.md" else "| Phục hồi |", start)
    if start<0 or end<start:
        errors.append(landing+": missing capability table")
    elif any(not line.startswith("|") for line in content[start:end].splitlines() if line.strip()):
        errors.append(landing+": capability table interrupted")
    if "dangkhoa201/" in content: errors.append(landing+": incorrect GitHub owner")
    if "39538635309" in content: errors.append(landing+": obsolete CI reference")
    if landing=="README.md" and "upcoming **Security Activity Center**" in content:
        errors.append(landing+": released feature still marked upcoming")
for guide in ("docs/reproducibility.md", "docs/reproducibility.vi.md"):
    if "github.com/dangkhoa201/" in (ROOT/guide).read_text():
        errors.append(guide+": incorrect clone URL")


# Offline Git reference integrity gate: avoids stale links after history rewrites.
# GitHub Actions run IDs are ephemeral and must not be hardcoded in committed docs.
FULL_GIT_SHA = re.compile(r'(?<![0-9a-fA-F])[0-9a-fA-F]{40}(?![0-9a-fA-F])')
COMMIT_URL = re.compile(
    r'https://github[.]com/dangkhoa2016/Rails-8-Envelope-Encryption-Vault/commit/([0-9a-fA-F]{7,40})'
)
RUN_URL = re.compile(
    r'https://github[.]com/dangkhoa2016/Rails-8-Envelope-Encryption-Vault/actions/runs/[0-9]+'
)
def git_ref_kind(sha):
    found = subprocess.run(['git', '-C', str(ROOT), 'cat-file', '-t', sha],
                           capture_output=True, text=True)
    return found.stdout.strip() if found.returncode == 0 else None

def reachable_commit(sha):
    return subprocess.run(['git', '-C', str(ROOT), 'merge-base', '--is-ancestor',
                           sha, 'HEAD'], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0

# The lint workflow uses a shallow checkout. Only the commit/tree pins that
# are independently checked by the full-history Documentation workflow may
# be unresolved in that shallow view. No other missing SHA is trusted.
pin_validator = (ROOT / 'script/notebook-demo-check').read_text()
pin_commit = re.search(r'^COMMIT = "([a-f0-9]{40})"$', pin_validator, re.MULTILINE)
pin_tree = re.search(r'^TREE = "([a-f0-9]{40})"$', pin_validator, re.MULTILINE)
if not pin_commit or not pin_tree:
    errors.append('Missing strict notebook application commit/tree pins')
    shallow_pins = set()
else:
    shallow_pins = {pin_commit.group(1), pin_tree.group(1)}
is_shallow = subprocess.run(
    ['git', '-C', str(ROOT), 'rev-parse', '--is-shallow-repository'],
    capture_output=True, text=True
).stdout.strip() == 'true'

for doc in docs:
    body = doc.read_text()
    where = doc.relative_to(ROOT).as_posix()
    for match in FULL_GIT_SHA.finditer(body):
        sha = match.group(0).lower()
        kind = git_ref_kind(sha)
        if kind == 'commit':
            if not reachable_commit(sha):
                errors.append(where + ': commit outside current HEAD history ' + sha)
        elif kind != 'tree' and not (is_shallow and sha in shallow_pins):
            errors.append(where + ': unknown or unsupported 40-character Git object ' + sha)
    for match in COMMIT_URL.finditer(body):
        sha = match.group(1).lower()
        if git_ref_kind(sha) != 'commit' or not reachable_commit(sha):
            errors.append(where + ': broken/unreachable GitHub commit URL ' + sha)
    if RUN_URL.search(body):
        errors.append(where + ': hardcoded historical GitHub workflow run; link to workflow instead')

must=[
'.github/CODEOWNERS','.github/dependabot.yml','.github/workflows/ci.yml',
'.github/workflows/docs.yml','.github/ISSUE_TEMPLATE/bug_report.yml',
'.github/ISSUE_TEMPLATE/feature_request.yml','.github/ISSUE_TEMPLATE/config.yml',
'.github/PULL_REQUEST_TEMPLATE.md','.github/PULL_REQUEST_TEMPLATE.vi.md']
for rel in must:
    if not (ROOT/rel).is_file():errors.append('Missing GitHub integration: '+rel)
if errors:
    print('DOC_QUALITY=FAIL, '+str(len(errors))+' errors')
    for e in errors:print('ERROR:',e)
    sys.exit(1)
print('DOC_QUALITY=PASS pairs='+str(pair_count)+' files='+str(len(docs))+' local_links='+str(checked))

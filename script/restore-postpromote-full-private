#!/usr/bin/env bash
set -Eeuo pipefail

HOTFIX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

usage() {
  cat >&2 <<'USAGE'
usage: script/restore-postpromote-full-private \
  --archive /absolute/POSTPROMOTE-FULL-PRIVATE.tar.gz.age \
  --outer-key /absolute/OUTER-RECOVERY.agekey \
  [--install-root /content] [--replace-source] [--inspect-only] \
  [--repoint-current] [--start-production]

Default behavior restores source, private authority and the stable production DB,
then rebuilds host-local production.env. Repoint/start are explicit opt-ins.
USAGE
  exit 64
}

archive=""
outer_key=""
install_root="/content"
replace_source=0
inspect_only=0
repoint=0
start_production=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --archive) archive="${2:-}"; shift 2 ;;
    --outer-key) outer_key="${2:-}"; shift 2 ;;
    --install-root) install_root="${2:-}"; shift 2 ;;
    --replace-source) replace_source=1; shift ;;
    --inspect-only) inspect_only=1; shift ;;
    --repoint-current) repoint=1; shift ;;
    --start-production) start_production=1; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

for p in "$archive" "$outer_key"; do
  [[ "$p" == /* && "$p" != "/" && -f "$p" && -r "$p" ]] || {
    echo "POSTPROMOTE_RESTORE=FAIL reason=invalid-input" >&2
    exit 2
  }
done
[[ "$install_root" == /* && "$install_root" != "/" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=install-root-absolute-path-required" >&2
  exit 2
}
command -v age >/dev/null || { echo "POSTPROMOTE_RESTORE=FAIL reason=age-missing" >&2; exit 2; }
command -v tar >/dev/null || { echo "POSTPROMOTE_RESTORE=FAIL reason=tar-missing" >&2; exit 2; }

mode="$(stat -c '%a' "$outer_key" 2>/dev/null || stat -f '%Lp' "$outer_key")"
[[ "$mode" == "600" || "$mode" == "400" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=unsafe-outer-key-mode" >&2
  exit 2
}

if [[ -f "$archive.sha256" ]]; then
  (cd "$(dirname "$archive")" && sha256sum -c "$(basename "$archive.sha256")" >/dev/null)
  echo "POSTPROMOTE_ARCHIVE_SHA256=PASS"
else
  echo "POSTPROMOTE_ARCHIVE_SHA256=SKIP"
fi

work="$(mktemp -d)"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT
plain="$work/bundle.tar.gz"
unpack="$work/unpack"
mkdir -p "$unpack"
age -d -i "$outer_key" -o "$plain" "$archive"
tar -C "$unpack" -xzf "$plain"
rm -f "$plain"
bundle="$(find "$unpack" -mindepth 1 -maxdepth 1 -type d -print -quit)"
[[ -n "$bundle" && -f "$bundle/meta/MANIFEST-SHA256.txt" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=invalid-bundle" >&2
  exit 2
}
(cd "$bundle" && sha256sum -c meta/MANIFEST-SHA256.txt >/dev/null)
echo "POSTPROMOTE_INTERNAL_MANIFEST=PASS"

metadata="$bundle/release-artifacts/RELEASE-METADATA.json"
[[ -f "$metadata" ]] || { echo "POSTPROMOTE_RESTORE=FAIL reason=missing-release-metadata" >&2; exit 2; }
readarray -t meta_fields < <(python3 - "$metadata" <<'PY'
import json,sys
D=json.load(open(sys.argv[1]))
if D.get('phase') != 'promoted' or D.get('promotion_performed') is not True:
    raise SystemExit('POSTPROMOTE_RESTORE=FAIL reason=bundle-not-promoted')
if D.get('release_verify') != 'pass' or D.get('sealed_source_integrity') != 'pass':
    raise SystemExit('POSTPROMOTE_RESTORE=FAIL reason=release-evidence-not-pass')
print(D.get('release_version',''))
print(D.get('offhost_roundtrip',''))
PY
)
version="${meta_fields[0]}"
offhost="${meta_fields[1]}"
[[ -n "$version" ]] || { echo "POSTPROMOTE_RESTORE=FAIL reason=missing-release-version" >&2; exit 2; }
reconstructed_name="reconstructed-authority-$version"
release_secrets_name="release-secrets-$version"
echo "POSTPROMOTE_BUNDLE_METADATA=PASS version=$version offhost_roundtrip=$offhost"

rc_src="$(find "$bundle/source" -mindepth 1 -maxdepth 1 -type d -name 'RC-*' -print -quit)"
dev_src="$(find "$bundle/source" -mindepth 1 -maxdepth 1 -type d -name 'DEV-*' -print -quit)"
dump="$(find "$bundle/database" -maxdepth 1 -type f -name '*.dump' -print -quit)"
private="$bundle/private-authority"
[[ -n "$rc_src" && -n "$dev_src" && -n "$dump" && -d "$private" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=missing-bundle-component" >&2
  exit 2
}
git -C "$rc_src" fsck --full >/dev/null
git -C "$dev_src" fsck --full >/dev/null
echo "POSTPROMOTE_SOURCE_VERIFY=PASS"

if [[ "$inspect_only" == "1" ]]; then
  command -v pg_restore >/dev/null || {
    echo "POSTPROMOTE_RESTORE=FAIL reason=pg_restore-missing" >&2
    exit 2
  }
  pg_restore -l "$dump" >/dev/null 2>&1 || {
    echo "POSTPROMOTE_RESTORE=FAIL reason=invalid-database-dump" >&2
    exit 2
  }
  echo "POSTPROMOTE_DATABASE_CATALOG=PASS"
  echo "POSTPROMOTE_RESTORE_INSPECT=PASS version=$version"
  exit 0
fi

rc_name="$(basename "$rc_src")"
dev_name="$(basename "$dev_src")"
rc_dst="$install_root/$rc_name"
dev_dst="$install_root/$dev_name"

[[ -d "$private/$release_secrets_name" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=missing-release-secrets path=$private/$release_secrets_name" >&2
  exit 2
}
[[ -f "$private/ruby-encrypt-env" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=missing-private-authority path=$private/ruby-encrypt-env" >&2
  exit 2
}
[[ -f "$private/production.env" ]] || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=missing-private-authority path=$private/production.env" >&2
  exit 2
}

for dst in "$rc_dst" "$dev_dst"; do
  if [[ -e "$dst" && "$replace_source" != "1" ]]; then
    echo "POSTPROMOTE_RESTORE=FAIL reason=source-exists path=$dst" >&2
    exit 2
  fi
done
if [[ "$replace_source" == "1" ]]; then
  rm -rf "$rc_dst" "$dev_dst"
fi
mkdir -p "$install_root"
cp -a "$rc_src" "$rc_dst"
cp -a "$dev_src" "$dev_dst"
mkdir -p "$rc_dst/tmp/release-artifacts" "$rc_dst/tmp/release-history"
cp -a "$bundle/release-artifacts/." "$rc_dst/tmp/release-artifacts/"
[[ -d "$bundle/release-history" ]] && cp -a "$bundle/release-history/." "$rc_dst/tmp/release-history/"
[[ -d "$bundle/evidence/$reconstructed_name" ]] && cp -a "$bundle/evidence/$reconstructed_name" "$install_root/$reconstructed_name"
echo "POSTPROMOTE_SOURCE_RESTORE=PASS"

runtime_root="$install_root/.ruby-envelope-vault-runtime"
export RUNTIME_ROOT="$runtime_root"
mkdir -p "$runtime_root" "$install_root/$release_secrets_name"
chmod 700 "$runtime_root" "$install_root/$release_secrets_name"
install -m 600 "$private/ruby-encrypt-env" "$install_root/ruby-encrypt-env"
cp -a "$private/$release_secrets_name/." "$install_root/$release_secrets_name/"
chmod -R go-rwx "$install_root/$release_secrets_name"
for f in "$private"/RUBY-ENVELOPE-VAULT-v*-PRIVATE-DR-PROMOTED-*; do
  [[ -f "$f" ]] && install -m 600 "$f" "$install_root/$(basename "$f")"
done
echo "POSTPROMOTE_PRIVATE_AUTHORITY_RESTORE=PASS"

START_SERVER=0 RUN_TESTS=0 ENV_FILE="$rc_dst/.env.kaggle" "$rc_dst/bootstrap.sh" setup >/dev/null
echo "POSTPROMOTE_BOOTSTRAP=PASS"

source "$rc_dst/activate-runtime.sh" >/dev/null
command -v pg_restore >/dev/null || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=pg_restore-missing-after-bootstrap" >&2
  exit 2
}
pg_restore -l "$dump" >/dev/null 2>&1 || {
  echo "POSTPROMOTE_RESTORE=FAIL reason=invalid-database-dump" >&2
  exit 2
}
echo "POSTPROMOTE_DATABASE_CATALOG=PASS"

"$HOTFIX_ROOT/script/rebuild-production-env" \
  --runtime-env "$rc_dst/.env.kaggle" \
  --aws-secret "$install_root/ruby-encrypt-env" \
  --base-production-env "$private/production.env" \
  --release-root "$rc_dst" \
  --output "$runtime_root/production.env" >/dev/null
echo "POSTPROMOTE_PRODUCTION_ENV_REBUILD=PASS"

# shellcheck disable=SC1091
source "$rc_dst/activate-runtime.sh" >/dev/null
set -a
# shellcheck disable=SC1090
source "$rc_dst/.env.kaggle"
set +a
stable_db="$("$rc_dst/script/production-database-name")"
pg_bindir="$(pg_config --bindir)"
pg_socket="$runtime_root/postgres/socket"
pg_port="${PG_PORT:-5432}"
exists="$("$pg_bindir/psql" -h "$pg_socket" -p "$pg_port" -U postgres -d postgres -Atqc "select count(*) from pg_database where datname='$stable_db'")"
if [[ "$exists" != "0" ]]; then
  "$pg_bindir/dropdb" -h "$pg_socket" -p "$pg_port" -U postgres --if-exists --force "$stable_db"
fi
"$pg_bindir/createdb" -h "$pg_socket" -p "$pg_port" -U postgres -O "$POSTGRES_APP_USER" "$stable_db"
target_database_url="$(python3 - "$DATABASE_URL" "$stable_db" <<'PY'
import sys
from urllib.parse import urlsplit,urlunsplit
u=urlsplit(sys.argv[1])
print(urlunsplit((u.scheme,u.netloc,'/'+sys.argv[2],u.query,u.fragment)))
PY
)"
sha256sum "$dump" > "$dump.sha256"
chmod 600 "$dump.sha256"
echo "POSTPROMOTE_DATABASE_SIDECAR=PASS"
TARGET_DATABASE_URL="$target_database_url" "$rc_dst/script/restore-db" "$dump" >/dev/null
PRODUCTION_ENV_FILE="$runtime_root/production.env" "$rc_dst/script/production-database-contract" >/dev/null
echo "POSTPROMOTE_DATABASE_RESTORE=PASS database_name=$stable_db"

if [[ "$repoint" == "1" ]]; then
  ln -sfn "$rc_dst" "$install_root/current"
  echo "POSTPROMOTE_REPOINT=PASS current=$rc_dst"
fi

if [[ "$start_production" == "1" ]]; then
  [[ "$repoint" == "1" ]] || { echo "POSTPROMOTE_RESTORE=FAIL reason=start-requires-repoint" >&2; exit 2; }
  set -a
  # shellcheck disable=SC1090
  source "$install_root/ruby-encrypt-env"
  set +a
  export PRODUCTION_ENV_FILE="$runtime_root/production.env"
  mkdir -p "$runtime_root/logs"
  nohup "$rc_dst/script/start-production" >"$runtime_root/logs/production-$version.log" 2>&1 &
  pid=$!
  up=000; ready=000
  for _ in $(seq 1 30); do
    up="$(curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/up 2>/dev/null || true)"
    ready="$(curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/ready 2>/dev/null || true)"
    [[ "$up" == "200" && "$ready" == "200" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  [[ "$up" == "200" && "$ready" == "200" ]] || {
    echo "POSTPROMOTE_RESTORE=FAIL reason=production-health up=$up ready=$ready" >&2
    exit 3
  }
  echo "POSTPROMOTE_PRODUCTION_START=PASS up=200 ready=200"
fi

echo "POSTPROMOTE_RESTORE=PASS version=$version"

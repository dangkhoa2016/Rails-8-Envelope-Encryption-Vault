#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: script/rebuild-production-env \
  --runtime-env /absolute/.env.kaggle \
  --aws-secret /absolute/aws.env \
  [--base-production-env /absolute/old-production.env] \
  [--release-root /absolute/restored-release] \
  [--output /absolute/production.env]
USAGE
  exit 64
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
release_root="$ROOT"
runtime_env=""
aws_secret=""
base_env=""
output=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime-env) runtime_env="${2:-}"; shift 2 ;;
    --aws-secret) aws_secret="${2:-}"; shift 2 ;;
    --base-production-env) base_env="${2:-}"; shift 2 ;;
    --release-root) release_root="${2:-}"; shift 2 ;;
    --output) output="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

[[ "$release_root" == /* && "$release_root" != "/" && -d "$release_root" ]] || {
  echo "REBUILD_PRODUCTION_ENV=FAIL reason=invalid-release-root" >&2
  exit 2
}
[[ -x "$release_root/script/production-database-name" && -x "$release_root/script/production-database-contract" ]] || {
  echo "REBUILD_PRODUCTION_ENV=FAIL reason=release-contract-missing" >&2
  exit 2
}

for p in "$runtime_env" "$aws_secret"; do
  [[ "$p" == /* && "$p" != "/" && -f "$p" && -r "$p" ]] || {
    echo "REBUILD_PRODUCTION_ENV=FAIL reason=invalid-input" >&2
    exit 2
  }
done

export ENV_FILE=/dev/null
# shellcheck disable=SC1091
source "$ROOT/activate-runtime.sh" >/dev/null

base_app_hosts="localhost"
base_app_url="http://127.0.0.1:3000"
base_demo_mode="true"
base_force_ssl="false"
base_allow_signups="false"
base_require_mfa="false"
base_reauth_on_reveal="false"
if [[ -n "$base_env" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/script/lib/production-env.sh"
  revault_validate_production_env_path "$release_root" "$base_env" || exit 2
  set -a
  # shellcheck disable=SC1090
  source "$base_env"
  set +a
  base_app_hosts="${APP_HOSTS:-$base_app_hosts}"
  base_app_url="${APP_URL:-$base_app_url}"
  base_demo_mode="${DEMO_MODE:-$base_demo_mode}"
  base_force_ssl="${FORCE_SSL:-$base_force_ssl}"
  base_allow_signups="${ALLOW_SIGNUPS:-$base_allow_signups}"
  base_require_mfa="${REQUIRE_MFA:-$base_require_mfa}"
  base_reauth_on_reveal="${REAUTH_ON_REVEAL:-$base_reauth_on_reveal}"
fi

set -a
# shellcheck disable=SC1090
source "$runtime_env"
set +a
runtime_database_url="${DATABASE_URL:?DATABASE_URL is required by runtime env}"
runtime_secret_key_base="${SECRET_KEY_BASE:?SECRET_KEY_BASE is required by runtime env}"

normalized_aws="$(mktemp)"
cleanup() { rm -f "$normalized_aws"; }
trap cleanup EXIT
chmod 600 "$normalized_aws"
REQUIRED_SECRET_VARS='AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION AWS_KMS_KEY_ID AWS_KMS_KEY01_ID AWS_KMS_KEY02_ID' \
  "$ROOT/script/prepare-secret-env" "$aws_secret" "$normalized_aws" >/dev/null
set -a
# shellcheck disable=SC1090
source "$normalized_aws"
set +a

stable_db="$("$release_root/script/production-database-name")"
target_database_url="$(python3 - "$runtime_database_url" "$stable_db" <<'PY'
import sys
from urllib.parse import urlsplit, urlunsplit
u=urlsplit(sys.argv[1])
print(urlunsplit((u.scheme,u.netloc,"/"+sys.argv[2],u.query,u.fragment)))
PY
)"

if [[ -z "$output" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/script/lib/production-env.sh"
  output="$(revault_production_env_path)"
fi
[[ "$output" == /* && "$output" != "/" ]] || {
  echo "REBUILD_PRODUCTION_ENV=FAIL reason=output-absolute-path-required" >&2
  exit 2
}
mkdir -p "$(dirname "$output")"

umask 077
{
  printf '# Generated by script/rebuild-production-env. DO NOT COMMIT.\n'
  printf 'export RAILS_ENV=production\n'
  printf 'export DATABASE_URL=%q\n' "$target_database_url"
  printf 'export SECRET_KEY_BASE=%q\n' "$runtime_secret_key_base"
  printf 'export VAULT_KEY_PROVIDER=aws_kms\n'
  printf 'export VAULT_ACTIVE_KEK_ID=%q\n' "$AWS_KMS_KEY_ID"
  printf 'export APP_HOSTS=%q\n' "${PRODUCTION_APP_HOSTS:-$base_app_hosts}"
  printf 'export APP_URL=%q\n' "${PRODUCTION_APP_URL:-$base_app_url}"
  printf 'export DEMO_MODE=%q\n' "${PRODUCTION_DEMO_MODE:-$base_demo_mode}"
  printf 'export FORCE_SSL=%q\n' "${PRODUCTION_FORCE_SSL:-$base_force_ssl}"
  printf 'export ALLOW_SIGNUPS=%q\n' "${PRODUCTION_ALLOW_SIGNUPS:-$base_allow_signups}"
  printf 'export REQUIRE_MFA=%q\n' "${PRODUCTION_REQUIRE_MFA:-$base_require_mfa}"
  printf 'export REAUTH_ON_REVEAL=%q\n' "${PRODUCTION_REAUTH_ON_REVEAL:-$base_reauth_on_reveal}"
} > "$output"
chmod 600 "$output"

PRODUCTION_ENV_FILE="$output" "$release_root/script/production-database-contract" >/dev/null

echo "REBUILD_PRODUCTION_ENV=PASS output=$output database_name=$stable_db provider=aws_kms"
echo "REBUILD_PRODUCTION_ENV_CREDENTIALS_EMBEDDED=no"

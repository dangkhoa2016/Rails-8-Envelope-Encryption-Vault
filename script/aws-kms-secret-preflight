#!/usr/bin/env python3
import re
import stat
import sys
from pathlib import Path

if len(sys.argv) != 2 or not sys.argv[1].startswith("/"):
    print("usage: script/aws-kms-secret-preflight /absolute/path/to/env", file=sys.stderr)
    raise SystemExit(64)

path = Path(sys.argv[1])
if not path.is_file():
    print("AWS_KMS_SECRET_STATUS=FAIL reason=missing")
    raise SystemExit(2)

mode = stat.S_IMODE(path.stat().st_mode)
data = path.read_bytes()
print("AWS_KMS_SECRET_PRESENT=yes")
print(f"AWS_KMS_SECRET_MODE={mode:o}")
print("AWS_KMS_SECRET_MODE_RESTRICTED=" + ("yes" if mode in (0o600, 0o400) else "no"))
print("AWS_KMS_SECRET_CRLF=" + ("yes" if b"\r\n" in data else "no"))
print("AWS_KMS_SECRET_NUL=" + ("yes" if b"\x00" in data else "no"))

if b"\x00" in data:
    print("AWS_KMS_SECRET_STATUS=FAIL reason=nul-byte")
    raise SystemExit(2)

try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    print("AWS_KMS_SECRET_STATUS=FAIL reason=invalid-utf8")
    raise SystemExit(2)

values = {}
for raw in text.replace("\r\n", "\n").replace("\r", "\n").splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    match = re.match(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
    if not match:
        continue
    name, value = match.groups()
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        value = value[1:-1]
    values[name] = value

required = (
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "AWS_KMS_KEY_ID",
    "AWS_KMS_KEY01_ID",
    "AWS_KMS_KEY02_ID",
)

missing = False
for name in required:
    present = bool(values.get(name))
    print(f"AWS_KMS_SECRET_REQUIRED_{name}=" + ("present" if present else "missing"))
    missing = missing or not present

if missing:
    print("AWS_KMS_SECRET_STATUS=FAIL reason=missing-required-variable")
    raise SystemExit(2)

active_matches_key02 = values["AWS_KMS_KEY_ID"] == values["AWS_KMS_KEY02_ID"]
active_differs_key01 = values["AWS_KMS_KEY_ID"] != values["AWS_KMS_KEY01_ID"]

print("AWS_KMS_ACTIVE_ALIAS_MATCHES_KEY02=" + ("yes" if active_matches_key02 else "no"))
print("AWS_KMS_ACTIVE_ALIAS_DIFFERS_KEY01=" + ("yes" if active_differs_key01 else "no"))
print("AWS_SESSION_TOKEN=" + ("present" if values.get("AWS_SESSION_TOKEN") else "absent"))

if mode not in (0o600, 0o400):
    print("AWS_KMS_SECRET_STATUS=FAIL reason=unsafe-mode")
    raise SystemExit(2)

if not active_matches_key02 or not active_differs_key01:
    print("AWS_KMS_SECRET_STATUS=FAIL reason=active-alias-drift")
    raise SystemExit(3)

print("AWS_KMS_SECRET_STATUS=PASS")

#!/usr/bin/env python3
import os
import re
import shlex
import stat
import sys
from pathlib import Path

USAGE = "usage: script/prepare-secret-env [--fix-input-mode] [--check-only] INPUT [OUTPUT]"


def fail(reason, code=2):
    print(f"SECRET_ENV_STATUS=FAIL reason={reason}")
    raise SystemExit(code)


def parse_args(argv):
    fix_input_mode = False
    check_only = False
    positional = []
    for arg in argv:
        if arg == "--fix-input-mode":
            fix_input_mode = True
        elif arg == "--check-only":
            check_only = True
        elif arg in ("--help", "-h"):
            print(USAGE, file=sys.stderr)
            raise SystemExit(64)
        elif arg.startswith("-"):
            print(USAGE, file=sys.stderr)
            raise SystemExit(64)
        else:
            positional.append(arg)
    if not 1 <= len(positional) <= 2:
        print(USAGE, file=sys.stderr)
        raise SystemExit(64)
    return fix_input_mode, check_only, positional


def parse_env(text):
    values = {}
    order = []
    for lineno, raw in enumerate(text.splitlines(), start=1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            tokens = shlex.split(line, comments=True, posix=True)
        except ValueError:
            fail(f"invalid-env-syntax-line-{lineno}")
        if tokens and tokens[0] == "export":
            tokens = tokens[1:]
        if len(tokens) != 1:
            fail(f"unsupported-env-line-{lineno}")
        match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)", tokens[0], re.DOTALL)
        if not match:
            fail(f"unsupported-env-line-{lineno}")
        name, value = match.groups()
        if name not in values:
            order.append(name)
        values[name] = value
    return order, values


def default_output(input_path):
    runtime_root = os.environ.get("RUNTIME_ROOT", "")
    if not runtime_root:
        if os.path.isdir("/content") and os.access("/content", os.W_OK):
            runtime_root = "/content/.ruby-envelope-vault-runtime"
        else:
            kaggle_working = os.environ.get("KAGGLE_WORKING_DIR") or os.path.join(os.sep, "kaggle", "working")
            if os.path.isdir(kaggle_working) and os.access(kaggle_working, os.W_OK):
                runtime_root = str(Path(kaggle_working) / ".ruby-envelope-vault-runtime")
            else:
                state = os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))
                runtime_root = str(Path(state) / "ruby-envelope-vault/runtime")
    return str(Path(runtime_root) / "secrets" / f"{input_path.name}.normalized")


fix_input_mode, check_only, positional = parse_args(sys.argv[1:])
input_path = Path(positional[0])
if not input_path.is_absolute() or str(input_path) == "/":
    fail("absolute-path-required")
if not input_path.is_file() or not os.access(input_path, os.R_OK):
    fail("unreadable")

mode = stat.S_IMODE(input_path.stat().st_mode)
restricted = mode in (0o600, 0o400)
if fix_input_mode and not restricted:
    input_path.chmod(0o600)
    mode = 0o600
    restricted = True

data = input_path.read_bytes()
crlf = b"\r\n" in data
nul = b"\x00" in data

print("SECRET_ENV_PRESENT=yes")
print(f"SECRET_ENV_INPUT_MODE={mode:o}")
print("SECRET_ENV_INPUT_MODE_RESTRICTED=" + ("yes" if restricted else "no"))
print("SECRET_ENV_CRLF=" + ("yes" if crlf else "no"))
print("SECRET_ENV_NUL=" + ("yes" if nul else "no"))

if nul:
    fail("nul-byte")

try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    fail("invalid-utf8")

text = text.replace("\r\n", "\n").replace("\r", "\n")
order, values = parse_env(text)

missing = False
for name in os.environ.get("REQUIRED_SECRET_VARS", "").split():
    if name in values:
        print(f"SECRET_ENV_REQUIRED_{name}=present")
    else:
        print(f"SECRET_ENV_REQUIRED_{name}=missing")
        missing = True
if missing:
    fail("missing-required-variable")

if check_only:
    print("SECRET_ENV_STATUS=PASS")
    raise SystemExit(0)

output_path = Path(positional[1] if len(positional) == 2 else default_output(input_path))
if not output_path.is_absolute() or str(output_path) == "/":
    fail("output-absolute-path-required")

if not output_path.parent.exists():
    output_path.parent.mkdir(parents=True, mode=0o700)
elif not output_path.parent.is_dir():
    fail("output-parent-not-directory")

lines = [f"export {name}={shlex.quote(values[name])}\n" for name in order]
fd = os.open(output_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
try:
    with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
        handle.writelines(lines)
finally:
    try:
        os.chmod(output_path, 0o600)
    except FileNotFoundError:
        pass

print(f"SECRET_ENV_OUTPUT={output_path}")
print("SECRET_ENV_OUTPUT_MODE=600")
print("SECRET_ENV_STATUS=PASS")

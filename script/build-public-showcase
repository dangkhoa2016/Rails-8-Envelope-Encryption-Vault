#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '\r\n' < "$ROOT/VERSION")"
SHOWCASE_DIR="${SHOWCASE_DIR:-$ROOT/tmp/showcase/screenshots}"
OUTPUT_DIR="${PUBLIC_SHOWCASE_OUTPUT_DIR:-$ROOT/tmp/public-showcase}"
NAME="ruby-envelope-vault-${VERSION}-PUBLIC-SHOWCASE"
STAGE="$OUTPUT_DIR/$NAME"
ARCHIVE="$OUTPUT_DIR/$NAME.tar.gz"

rm -rf "$STAGE" "$ARCHIVE" "$ARCHIVE.sha256"
mkdir -p "$STAGE/docs" "$STAGE/screenshots"

for f in README.md VERSION FIX25-RELEASE-NOTES.md FIX27-RELEASE-NOTES.md FIX28-RELEASE-NOTES.md FIX29-RELEASE-NOTES.md FIX30-RELEASE-NOTES.md FIX31-RELEASE-NOTES.md FIX32-RELEASE-NOTES.md FIX33-RELEASE-NOTES.md FIX34-RELEASE-NOTES.md FIX35-RELEASE-NOTES.md FIX36-RELEASE-NOTES.md FIX37-RELEASE-NOTES.md FIX38-RELEASE-NOTES.md FIX39-RELEASE-NOTES.md FIX40-RELEASE-NOTES.md FIX41-RELEASE-NOTES.md FIX42-RELEASE-NOTES.md FIX43-RELEASE-NOTES.md FIX44-RELEASE-NOTES.md FIX45-RELEASE-NOTES.md FIX46-RELEASE-NOTES.md 0.1.3-RC1-RELEASE-NOTES.md 0.1.3-RELEASE-NOTES.md 0.1.5-RELEASE-NOTES.md 0.1.6-RELEASE-NOTES.md 0.1.6.1-RELEASE-NOTES.md CHANGELOG.md; do
  [ -f "$ROOT/$f" ] && cp "$ROOT/$f" "$STAGE/"
done
for f in docs/ARCHITECTURE-THREAT-MODEL-FIX25.md docs/ARCHITECTURE-SECURITY-OVERVIEW-FIX23.md docs/RECOVERY-OBSERVABILITY-FIX27.md docs/RECOVERY-DIAGNOSTICS-FIX28.md docs/ACCESSIBILITY-MANUAL-EVIDENCE-FIX26.md docs/ACCESSIBILITY-MANUAL-EVIDENCE-FIX40.md docs/ACCESSIBILITY-VERIFICATION-FIX25.md docs/PRODUCTION-UX-ACCESSIBILITY-ACCEPTANCE-FIX40.md docs/PRODUCTION-HTTP-SECURITY-FIX41.md docs/PRODUCTION-FAILURE-HANDLING-FIX42.md docs/PRODUCTION-LOGGING-REDACTION-FIX43.md docs/PRODUCTION-CSRF-ORIGIN-FIX44.md docs/PRODUCTION-RATE-LIMIT-FIX45.md docs/PRODUCTION-SESSION-LIFECYCLE-FIX46.md docs/UPGRADE-0.1.2-FIX46-TO-0.1.3.md docs/PRODUCTION-READINESS-0.1.3.md docs/SHOWCASE-WORKFLOW-FIX25.md docs/PUBLIC-SHOWCASE-FIX26.md docs/RELEASE-WORKFLOW-FIX31.md docs/PUBLIC-RELEASE-HISTORY.md docs/ARCHITECTURE-OVERVIEW-FIX33.md docs/PUBLIC-PORTFOLIO-INDEX-FIX33.md docs/PUBLIC-PORTFOLIO-LANDING-FIX34.md docs/DEV-0.1.5-PORTABILITY-MILESTONE-2026-10-02.md docs/DEV-0.1.5-PRODUCT-UX-MILESTONE-2026-10-02.md docs/DEV-0.1.5-SECURITY-WORKSPACE-UX-MILESTONE-2026-10-02.md docs/ROADMAP-0.1.4.md docs/OPERATOR-WORKFLOW-0.1.4.md docs/MANUAL-ACCESSIBILITY-EVIDENCE-0.1.4.md docs/KEY-PROVIDER-CONTRACT-0.1.4.md docs/EXTERNAL-KMS-ADAPTER-CONTRACT-0.1.4.md docs/ROADMAP-0.1.6.md docs/OPERATOR-WORKFLOW-0.1.6.md docs/MANUAL-ACCESSIBILITY-EVIDENCE-0.1.6.md docs/DEV-0.1.6-MILESTONE-1-RELEASE-TRUTH-2026-10-03.md docs/DEV-0.1.6-MILESTONE-3-AWS-KMS-AUTHORITY-AUDIT-2026-10-03.md docs/DEV-0.1.6-MILESTONE-4-KMS-ROLLBACK-HARDENING-2026-10-03.md docs/DEV-0.1.6-MILESTONE-5-KMS-OPERATOR-DIAGNOSTICS-2026-10-03.md docs/DEV-0.1.6-MILESTONE-6-AWS-KMS-FRESH-HOST-REHEARSAL-2026-10-03.md; do
  [ -f "$ROOT/$f" ] || { echo "missing public document: $f" >&2; exit 1; }
  cp "$ROOT/$f" "$STAGE/docs/"
done

[ -d "$SHOWCASE_DIR" ] || { echo "showcase directory not found: $SHOWCASE_DIR" >&2; exit 1; }
cp "$SHOWCASE_DIR"/*.png "$STAGE/screenshots/"
cp "$SHOWCASE_DIR"/SHA256SUMS.txt "$SHOWCASE_DIR"/MANIFEST.tsv "$STAGE/screenshots/"

if find "$STAGE" -type f | grep -E '/(\.env|rclone\.conf|.*\.(age|key|dump)|master-recovery|recovery\.agekey)$'; then
  echo "PUBLIC_SHOWCASE_DENYLIST=FAIL" >&2; exit 1
fi
if grep -RIlE 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AWS_SECRET_ACCESS_KEY=[^[:space:]]+|MASTER_PRIVATE_KEY=' "$STAGE"; then
  echo "PUBLIC_SHOWCASE_SECRET_PATTERN_SCAN=FAIL" >&2; exit 1
fi

( cd "$STAGE" && find . -type f ! -path './SHA256SUMS.txt' -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS.txt )
PUBLIC_PACKAGE_INTEGRITY_OUT="$OUTPUT_DIR/PUBLIC-PACKAGE-INTEGRITY.json" "$ROOT/script/public-showcase-validate" "$STAGE"
tar -C "$OUTPUT_DIR" -czf "$ARCHIVE" "$NAME"
sha256sum "$ARCHIVE" > "$ARCHIVE.sha256"
chmod 600 "$ARCHIVE" "$ARCHIVE.sha256"
echo "PUBLIC_SHOWCASE_PACKAGE=PASS"
echo "archive=$ARCHIVE"
cat "$ARCHIVE.sha256"

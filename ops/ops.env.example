# Copy to a root/operator-readable location outside the release tree, for example:
# /etc/ruby-envelope-vault/ops.env
# Keep mode 0600. Never commit real credentials or recovery material.

RAILS_ENV=production
DATABASE_URL=postgresql://vault_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/ruby_envelope_vault_production

# Rails production/decrypt context required by offsite DR.
SECRET_KEY_BASE=REPLACE_WITH_AT_LEAST_64_RANDOM_BYTES
VAULT_KEY_PROVIDER=local_file
VAULT_ACTIVE_KEK_ID=REPLACE_WITH_ACTIVE_KEK_ID
VAULT_KEK_DIR=/etc/ruby-envelope-vault/keks
APP_HOSTS=vault.example.invalid
APP_URL=https://vault.example.invalid
DEMO_MODE=false
FORCE_SSL=true
ALLOW_SIGNUPS=false
REQUIRE_MFA=true
REAUTH_ON_REVEAL=true

BACKUP_DIR=/var/lib/ruby-envelope-vault/backups
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
BACKUP_AGE_IDENTITY=/etc/ruby-envelope-vault/recovery.agekey

# rclone config must be readable by the scheduler service account.
RCLONE_CONFIG=/etc/ruby-envelope-vault/rclone.conf
OFFSITE_DRIVER=rclone
OFFSITE_RCLONE_DEST=ruby-vault-offsite:ruby-envelope-vault
RETENTION_KEEP=7
RETENTION_APPLY=0

# Pin compatible PostgreSQL client tools for backup/restore verification.
# PostgreSQL 17 is known-good for the current acceptance backup format.
OPS_POSTGRES_BIN=/usr/lib/postgresql/17/bin

# Required by periodic offsite DR. Use a deliberately fake canary secret.
USER_EMAIL=owner@example.com
ITEM_ID=REPLACE_WITH_FAKE_CANARY_ITEM_UUID
EXPECTED_CANARY_FIELD=notes
EXPECTED_CANARY_VALUE=REPLACE_WITH_FAKE_CANARY_VALUE

# DR orchestration mode: auto, url, or local-postgres.
# For local Unix-socket peer auth, DR_APP_OS_USER must exist and match the
# PostgreSQL role in DATABASE_URL (example DATABASE_URL role below: vault_app).
DR_ADMIN_MODE=auto
DR_APP_OS_USER=vault_app
DR_LOCAL_PG_SOCKET=/var/run/postgresql

# If DB creation/drop requires a separate admin role on the deployment host:
# DR_ADMIN_DATABASE_URL=postgresql://dr_admin:REPLACE_PASSWORD@127.0.0.1:5432/postgres

OPS_STATE_DIR=/var/lib/ruby-envelope-vault/ops-state
OPS_EVIDENCE_DIR=/var/lib/ruby-envelope-vault/ops-evidence
OPS_LOCK_FILE=/var/lib/ruby-envelope-vault/ops-state/scheduled-ops.lock

# Optional alert sinks.
# OPS_ALERT_FILE=/var/log/ruby-envelope-vault/ops-alerts.jsonl
# OPS_ALERT_WEBHOOK_URL=https://alerts.example.invalid/webhook
# OPS_ALERT_ON_SUCCESS=0

# Rails 8 Envelope Encryption Vault production runtime environment example.
# Copy to an OUT-OF-SOURCE path such as:
#   /etc/ruby-envelope-vault/ops.env
# or, on a notebook host:
#   /content/.ruby-envelope-vault-runtime/production.env
# Then chmod 600. Never commit real values.

RAILS_ENV=production
DATABASE_URL=postgresql://vault_user:REPLACE_ME@127.0.0.1:5432/ruby_envelope_vault_production
SECRET_KEY_BASE=REPLACE_WITH_AT_LEAST_64_BYTES
VAULT_KEY_PROVIDER=local_file
VAULT_ACTIVE_KEK_ID=REPLACE_ME
VAULT_KEK_DIR=/var/lib/ruby-envelope-vault/keks
APP_HOSTS=vault.example.invalid
DEMO_MODE=false
FORCE_SSL=true
ALLOW_SIGNUPS=false
REQUIRE_MFA=true
REAUTH_ON_REVEAL=true

# For AWS KMS deployments, set VAULT_KEY_PROVIDER=aws_kms and supply
# AWS_REGION/AWS_DEFAULT_REGION plus AWS credentials through the host's
# approved secret mechanism. Do not place credentials in source control.
